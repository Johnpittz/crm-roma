# ============================================
# SUPABASE (Banco de Dados)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada

# ============================================
# MILLENNIUM API (Integração ERP)
# ============================================
# Credenciais de acesso à API do Millennium
MILLENNIUM_USER=roma_integracao
MILLENNIUM_PASS=sua-senha-aqui

# Credenciais para scripts auxiliares (node/millennium_api.js, scripts/test-millennium.js)
MILLENNIUM_USERNAME=odata
MILLENNIUM_PASSWORD=sua-senha-aqui

# Chave secreta para validar webhooks vindos do Millennium
MILLENNIUM_WEBHOOK_SECRET=chave-secreta-para-webhooks

# ============================================
# CONFIGURAÇÕES DO SISTEMA
# ============================================
# Ambiente: development | staging | production
NODE_ENV=development

# URL do frontend (para callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# FEATURE FLAGS
# ============================================
# Habilitar sincronização automática com Millennium
ENABLE_MILLENNIUM_SYNC=true

# Intervalo de sincronização em minutos (0 = desabilitado)
SYNC_INTERVAL_MINUTES=60

# ============================================
# PROSPECÇÃO INTELIGENTE B2B
# ============================================
# Fonte de dados: 'cnpjota' ou 'cnpjaberto'
PROSPECCAO_FONTE=cnpjota

# Token da API CNPJota (cadastre-se em https://cnpjota.com.br)
# Plano: 10 créditos grátis no cadastro, depois R$0,10/empresa
CNPJOTA_TOKEN=seu-token-cnpjota

# API Key do CNPJ Aberto (cadastre-se em https://cnpjaberto.com.br)
# Plano gratuito: 1.000 requisições/dia
CNPJ_ABERTO_API_KEY=sua-api-key-cnpjaberto

# ============================================
# BOTCONVERSA (WhatsApp API - LEGADO)
# ============================================
# API Key do BotConversa (obter em Configurações → API)
BOTCONVERSA_API_KEY=sua-chave-api-botconversa

# URL da API do BotConversa (padrão: https://new-backend.botconversa.com.br/api/v1)
BOTCONVERSA_API_URL=https://new-backend.botconversa.com.br/api/v1

# ============================================
# WAHA (WhatsApp HTTP API) - NOVO
# ============================================
# URL do WAHA (ex: http://localhost:3001 ou http://2.25.192.248:3001)
# Docs: https://waha.devlike.pro/
WAHA_URL=http://localhost:3001

# Nome da sessão padrão (deve ser o mesmo criado no WAHA)
WAHA_SESSION=ROMA_1

# ============================================
# EVOLUTION API (FALLBACK)
# ============================================
# URL da Evolution API (para fallback se WAHA falhar)
# EVOLUTION_API_URL=http://localhost:8082
# EVOLUTION_API_KEY=sua-api-key-evolution
# EVOLUTION_INSTANCE=ROMA_1

# ============================================
# IA / AUTOMACAO (Opcional)
# ============================================
# OpenAI - para respostas automáticas
OPENAI_API_KEY=sk-sua...enai

# Configuração do assistente de vendas
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_MODEL=gpt-4
